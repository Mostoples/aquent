rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if caller is admin
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // users/{uid} — own profile or admin
    match /users/{uid} {
      allow read:  if request.auth != null &&
                     (request.auth.uid == uid || isAdmin());
      // Users can update their own profile (but NOT role or plan)
      allow update: if request.auth != null &&
                      request.auth.uid == uid &&
                      !('role' in request.resource.data.diff(resource.data).affectedKeys()) &&
                      !('plan' in request.resource.data.diff(resource.data).affectedKeys());
      // Only Firestore Admin SDK / admin users can write role / plan
      allow write:  if isAdmin();
      // Allow creation on first login (self-registration with role='free')
      allow create: if request.auth != null &&
                      request.auth.uid == uid &&
                      request.resource.data.role == 'free';
    }

    // Audit log untuk aktivitas admin (write-only oleh admin, read oleh admin)
    match /adminLogs/{logId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;  // logs immutable
    }
  }
}
